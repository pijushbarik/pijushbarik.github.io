---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About - Pijush Barik";
const description = "About Pijush";
const permalink = `${Astro.site.href}about`;
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="about"
>
  <div class="container">
    <h1>About</h1>
    <figure class="about-image">
      <img src="/assets/about-illustration.svg" width="330" alt="" />
    </figure>

    <p>Hi there! I am Pijush, a fullstack web developer & software engineer.</p>

    <p>I speak in JavaScript, Python, C++, C# and many more.</p>

    <p>
      I love to code and recently became a hobbyist homelab builder. Sharing
      (documenting) my homelab journey in my blog <a
        href="/blog/homelab-0-getting-started">here</a
      >.
    </p>

    <p>
      I love riding motorcycle, mountains, hill stations, books as my escape
      route.
    </p>
  </div>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 8px;
    margin-bottom: 1.5em;
    filter: invert(var(--about-illustration-color-invert));
  }

  html @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
