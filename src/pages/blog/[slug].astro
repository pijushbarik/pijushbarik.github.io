---
import { getCollection, getEntry, render } from "astro:content";
import readingTime from "reading-time";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Bio from "../../components/Bio.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({
    params: { slug: p.data.slug },
    props: { post: p },
  }));
}

async function getPostTitleFromId(id) {
  try {
    if (!id) return null;
    const post = await getEntry("posts", id);
    return post.data.title;
  } catch (e) {
    return null;
  }
}

const { post } = Astro.props;
const { title, slug, description, publishDate, tags, prevPost, nextPost } =
  post.data;
const readingTimeEstimate = readingTime(post.body).text;
const permalink = `${Astro.site.href}blog/${slug}`;

const prevPostTitle = await getPostTitleFromId(prevPost);
const nextPostTitle = await getPostTitleFromId(nextPost);

const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="blog"
>
  <header>
    <p>{publishDate} ~ {readingTimeEstimate}</p>
    <h1>{title}</h1>
    <hr />
  </header>
  <div class="container">
    <article class="content">
      <Content />
    </article>
    <hr />
    <Bio />

    <div class="tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>

    <div class="post-navigation">
      <div>
        {
          prevPost && (
            <a href={`/blog/${prevPost}`}>
              &larr; {prevPostTitle || "Previous"}
            </a>
          )
        }
      </div>
      <div>
        {
          nextPost && (
            <a href={`/blog/${nextPost}`}>{nextPostTitle || "Next"} &rarr;</a>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  header {
    text-align: center;
  }

  header h1 {
    margin-bottom: 0.7em;
  }

  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  header hr {
    min-width: 100px;
    width: 30%;
  }

  .post-navigation {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    padding: 2px 6px;
    border-radius: 3px;
    background-color: var(--tag-bg-color);
    color: var(--tag-color);
  }
</style>
