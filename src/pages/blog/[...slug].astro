---
import { render } from "astro:content";
import { getAllPublishedPosts } from "../../scripts/helpers";
import readingTime from "reading-time";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getAllPublishedPosts();

  return allPosts.map((post) => {
    return {
      params: { slug: post.id },
      props: { post: post },
    };
  });
}

async function getNextAndPrevPost(id) {
  const posts = await getAllPublishedPosts({
    sort: true,
    compareFn: (a, b) =>
      new Date(a.data.publishDate).valueOf() -
      new Date(b.data.publishDate).valueOf(),
  });

  const currentPostIndex = posts.findIndex((p) => p.id === id);

  const data = {
    next: null,
    prev: null,
  };

  if (currentPostIndex > 0) {
    const prevPost = posts[currentPostIndex - 1];
    data.prev = {
      title: prevPost.data.title,
      href: prevPost.id,
    };
  }

  if (currentPostIndex < posts.length - 1) {
    const nextPost = posts[currentPostIndex + 1];
    data.next = {
      title: nextPost.data.title,
      href: nextPost.id,
    };
  }

  return data;
}

const { post } = Astro.props;
const { title, description, publishDate, tags } = post.data;
const readingTimeEstimate = readingTime(post.body).text;
const permalink = `${Astro.site.href}blog/${post.id}`;

const { next: nextPost, prev: prevPost } = await getNextAndPrevPost(post.id);

const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="blog"
>
  <header>
    <p>{publishDate} ~ {readingTimeEstimate}</p>
    <h1>{title}</h1>
    <hr />
  </header>
  <div class="container">
    <article class="content">
      <Content />
    </article>
    <hr />

    <div class="tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>

    <div class="post-navigation">
      <div>
        {
          prevPost && (
            <a href={`/blog/${prevPost.href}`}>
              &larr; {prevPost.title || "Previous"}
            </a>
          )
        }
      </div>
      <div>
        {
          nextPost && (
            <a href={`/blog/${nextPost.href}`}>
              {nextPost.title || "Next"} &rarr;
            </a>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  header {
    text-align: center;
  }

  header h1 {
    margin-bottom: 0.7em;
  }

  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  header hr {
    min-width: 100px;
    width: 30%;
  }

  .post-navigation {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    padding: 2px 6px;
    border-radius: 3px;
    background-color: var(--tag-bg-color);
    color: var(--tag-color);
  }
</style>
